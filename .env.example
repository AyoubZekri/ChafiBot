DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chafi
DB_USERNAME=root
DB_PASSWORD=

EMBED_MODEL=intfloat/multilingual-e5-small
# GPU (Colab): BAAI/bge-reranker-v2-m3 | VPS بدون GPU: cross-encoder/mmarco-mMiniLMv2-L12-H384-v1 | فارغ = بدون
RERANK_MODEL=BAAI/bge-reranker-v2-m3
FULL_TEXT_MAX=2500
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b

# السرعة
NUM_PREDICT=350
NUM_CTX=4096
NUM_THREAD=0
KEEP_ALIVE=-1
DISABLE_THINKING=1
CHUNK_SIZE=700
CHUNK_OVERLAP=120
TOP_K=6

# الدقة
RELEVANCE_THRESHOLD=0.82
MAX_REWRITES=1
MAX_TOOL_ROUNDS=2
HISTORY_LIMIT=6

# نفس القيمة في .env الخاص بـ Laravel (AI_SERVICE_KEY)
AI_SERVICE_KEY=
